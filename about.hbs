<!doctype html>
<html lang="en">
<head>
<meta charset="utf-8">
<title>Oh My Shell: third-party licenses</title>
<style>
body { font: 14px/1.5 sans-serif; max-width: 60em; margin: 2em auto; padding: 0 1em; }
pre { white-space: pre-wrap; background: #f4f4f4; padding: 1em; }
li { margin: 0.2em 0; }
</style>
</head>
<body>
<h1>Third-party licenses</h1>
<p>Oh My Shell is MIT licensed (see LICENSE). The release binary includes the following packages.</p>
<h2>Licenses used</h2>
<ul>
{{#each overview}}
<li><a href="#{{id}}">{{name}}</a> ({{count}})</li>
{{/each}}
</ul>
<h2>License texts</h2>
<ul class="licenses-list">
{{#each licenses}}
<li class="license">
<h3 id="{{id}}">{{name}}</h3>
<h4>Used by:</h4>
<ul>
{{#each used_by}}
<li>{{crate.name}} {{crate.version}}{{#if crate.repository}} (<a href="{{crate.repository}}">{{crate.repository}}</a>){{/if}}</li>
{{/each}}
</ul>
<pre>{{text}}</pre>
</li>
{{/each}}
</ul>
</body>
</html>
