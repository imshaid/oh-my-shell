---
source: crates/omsh-syntax/tests/parser.rs
expression: render_lines(lines)
---
"$(a)"
  item "$(a)"
    simple "$(a)"
      word "$(a)"
        command-sub "$(a)"
          item "a"
            simple "a"
              word "a"

"$()"
  item "$()"
    simple "$()"
      word "$()"
        command-sub "$()"

"$( )"
  item "$( )"
    simple "$( )"
      word "$( )"
        command-sub "$( )"

"$(\n)"
  item "$(\n)"
    simple "$(\n)"
      word "$(\n)"
        command-sub "$(\n)"

"$(# only a comment\n)"
  item "$(# only a comment\n)"
    simple "$(# only a comment\n)"
      word "$(# only a comment\n)"
        command-sub "$(# only a comment\n)"

"$(a | b; c)"
  item "$(a | b; c)"
    simple "$(a | b; c)"
      word "$(a | b; c)"
        command-sub "$(a | b; c)"
          item "a | b;"
            pipeline "a | b"
              simple "a"
                word "a"
              simple "b"
                word "b"
          item "c"
            simple "c"
              word "c"

"x$(a)y"
  item "x$(a)y"
    simple "x$(a)y"
      word "x$(a)y"
        literal "x"
        command-sub "$(a)"
          item "a"
            simple "a"
              word "a"
        literal "y"

"\"$(a \"b c\")\""
  item "\"$(a \"b c\")\""
    simple "\"$(a \"b c\")\""
      word "\"$(a \"b c\")\""
        double "\"$(a \"b c\")\""
          command-sub "$(a \"b c\")"
            item "a \"b c\""
              simple "a \"b c\""
                word "a"
                word "\"b c\""
                  double "\"b c\""
                    literal "b c"

"$(a $(b $(c)))"
  item "$(a $(b $(c)))"
    simple "$(a $(b $(c)))"
      word "$(a $(b $(c)))"
        command-sub "$(a $(b $(c)))"
          item "a $(b $(c))"
            simple "a $(b $(c))"
              word "a"
              word "$(b $(c))"
                command-sub "$(b $(c))"
                  item "b $(c)"
                    simple "b $(c)"
                      word "b"
                      word "$(c)"
                        command-sub "$(c)"
                          item "c"
                            simple "c"
                              word "c"

"$(if a; then b; fi)"
  item "$(if a; then b; fi)"
    simple "$(if a; then b; fi)"
      word "$(if a; then b; fi)"
        command-sub "$(if a; then b; fi)"
          item "if a; then b; fi"
            if "if a; then b; fi"
              branch "if a; then b;"
                condition
                  item "a;"
                    simple "a"
                      word "a"
                then
                  item "b;"
                    simple "b"
                      word "b"

"$(case x in a) b;; esac)"
  item "$(case x in a) b;; esac)"
    simple "$(case x in a) b;; esac)"
      word "$(case x in a) b;; esac)"
        command-sub "$(case x in a) b;; esac)"
          item "case x in a) b;; esac"
            case "case x in a) b;; esac"
              word "x"
              arm "a) b"
                pattern "a"
                item "b"
                  simple "b"
                    word "b"

"$( (a) )"
  item "$( (a) )"
    simple "$( (a) )"
      word "$( (a) )"
        command-sub "$( (a) )"
          item "(a)"
            subshell "(a)"
              item "a"
                simple "a"
                  word "a"

"$(cat <<E\nhi\nE\n)"
  item "$(cat <<E\nhi\nE\n)"
    simple "$(cat <<E\nhi\nE\n)"
      word "$(cat <<E\nhi\nE\n)"
        command-sub "$(cat <<E\nhi\nE\n)"
          item "cat <<E"
            simple "cat <<E"
              word "cat"
              here-doc "<<E" delimiter="E"
                body "hi\n"
                  literal "hi\n"

"$(a # )\n)"
  item "$(a # )\n)"
    simple "$(a # )\n)"
      word "$(a # )\n)"
        command-sub "$(a # )\n)"
          item "a"
            simple "a"
              word "a"

"é$(ব\u{9be}ংল\u{9be} x)"
  item "é$(ব\u{9be}ংল\u{9be} x)"
    simple "é$(ব\u{9be}ংল\u{9be} x)"
      word "é$(ব\u{9be}ংল\u{9be} x)"
        literal "é"
        command-sub "$(ব\u{9be}ংল\u{9be} x)"
          item "ব\u{9be}ংল\u{9be} x"
            simple "ব\u{9be}ংল\u{9be} x"
              word "ব\u{9be}ংল\u{9be}"
              word "x"

"$(cat <<E)"
  item "$(cat <<E)"
    simple "$(cat <<E)"
      word "$(cat <<E)"
        command-sub "$(cat <<E)"
          item "cat <<E"
            simple "cat <<E"
              word "cat"
              here-doc "<<E" delimiter="E"
                body ""

"x=$(cat <<E)\nhello\nE\n"
  item "x=$(cat <<E)"
    simple "x=$(cat <<E)"
      assign "x=$(cat <<E)" name="x" at "x"
        value "$(cat <<E)"
          command-sub "$(cat <<E)"
            item "cat <<E"
              simple "cat <<E"
                word "cat"
                here-doc "<<E" delimiter="E"
                  body ""
  item "hello"
    simple "hello"
      word "hello"
  item "E"
    simple "E"
      word "E"
