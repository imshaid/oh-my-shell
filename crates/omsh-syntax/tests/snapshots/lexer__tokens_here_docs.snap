source: crates/omsh-syntax/tests/lexer.rs
expression: render_tokens(lines)
---
"cat <<EOF\nhello $x $(y) `z` \\$ \\q \"q\" 'q'\nEOF\n"
  0..3 Word "cat"
  4..6 Op HereDoc
  6..9 Word "EOF"
  9..10 Newline
  10..46 HereDocBody "hello $x $(y) `z` \\$ \\q \"q\" 'q'\n" end="EOF"
    10..16 Literal "hello "
    16..18 Parameter "x"
    18..19 Literal " "
    19..23 CommandSub "y"
    23..24 Literal " "
    24..27 Backtick "z"
    27..28 Literal " "
    28..30 Escaped "\\$"
    30..42 Literal " \\q \"q\" 'q'\n"

"cat <<'EOF'\nraw $x \\$\nEOF\n"
  0..3 Word "cat"
  4..6 Op HereDoc
  6..11 Word "'EOF'"
    6..11 SingleQuoted "EOF"
  11..12 Newline
  12..26 HereDocBody "raw $x \\$\n" end="EOF" quoted
    12..22 Literal "raw $x \\$\n"

"cat <<\"EOF\"\nraw $x\nEOF\n"
