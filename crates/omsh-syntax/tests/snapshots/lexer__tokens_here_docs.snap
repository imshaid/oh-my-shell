  4..6 Op HereDoc
  6..11 Word "\"EOF\""
    6..11 DoubleQuoted
      7..10 Literal "EOF"
  11..12 Newline
  12..23 HereDocBody "raw $x\n" end="EOF" quoted
    12..19 Literal "raw $x\n"

"cat <<\\EOF\nraw $x\nEOF\n"
