---
source: crates/omsh-syntax/tests/lexer.rs
expression: render_highlight(lines)
---
"cat <<EOF\nhello $x $(y) `z` \\$ \\q \"q\" 'q'\nEOF\n"
  Command "cat"
  Redirect "<<"
  HereDocDelimiter "EOF"
  HereDocBody "hello "
  Variable "$x"
  HereDocBody " "
  CommandSub "$("
  Command "y"
  CommandSub ")"
  HereDocBody " "
  CommandSub "`z`"
  HereDocBody " "
  Escape "\\$"
  HereDocBody " \\q \"q\" 'q'\n"
  HereDocDelimiter "EOF\n"

"cat <<'EOF'\nraw $x \\$\nEOF\n"
  Command "cat"
  Redirect "<<"
  SingleQuoted "'EOF'"
  HereDocBody "raw $x \\$\n"
  HereDocDelimiter "EOF\n"

"cat <<\"EOF\"\nraw $x\nEOF\n"
  Command "cat"
  Redirect "<<"
  DoubleQuoted "\"EOF\""
  HereDocBody "raw $x\n"
  HereDocDelimiter "EOF\n"

"cat <<\\EOF\nraw $x\nEOF\n"
  Command "cat"
  Redirect "<<"
  Escape "\\E"
  HereDocDelimiter "OF"
  HereDocBody "raw $x\n"
  HereDocDelimiter "EOF\n"

"cat <<E\"O\"F\nraw $x\nEOF\n"
  Command "cat"
  Redirect "<<"
  HereDocDelimiter "E"
  DoubleQuoted "\"O\""
  HereDocDelimiter "F"
  HereDocBody "raw $x\n"
  HereDocDelimiter "EOF\n"

"cat <<-EOF\n\tone\n\t\ttwo $x\n\tEOF\n"
  Command "cat"
  Redirect "<<-"
  HereDocDelimiter "EOF"
  HereDocBody "\tone\n\t\ttwo "
  Variable "$x"
  HereDocBody "\n"
  HereDocDelimiter "\tEOF\n"

"cat <<-'EOF'\n\tone\n\tEOF\n"
  Command "cat"
  Redirect "<<-"
  SingleQuoted "'EOF'"
  HereDocBody "\tone\n"
  HereDocDelimiter "\tEOF\n"

"cat <<A <<B | grep x # note\nfirst\nA\nsecond\nB\nnext\n"
  Command "cat"
  Redirect "<<"
  HereDocDelimiter "A"
  Redirect "<<"
  HereDocDelimiter "B"
  Operator "|"
  Command "grep"
  Argument "x"
  Comment "# note"
  HereDocBody "first\n"
  HereDocDelimiter "A\n"
  HereDocBody "second\n"
  HereDocDelimiter "B\n"
  Command "next"

"cat <<EOF\nno newline after delimiter\nEOF"
  Command "cat"
  Redirect "<<"
  HereDocDelimiter "EOF"
  HereDocBody "no newline after delimiter\n"
  HereDocDelimiter "EOF"

"cat <<EOF\nx\\\nEOF\nEOF\n"
  Command "cat"
  Redirect "<<"
  HereDocDelimiter "EOF"
  HereDocBody "x"
  Escape "\\\n"
  HereDocBody "EOF\n"
  HereDocDelimiter "EOF\n"

"cat <<EOF\nEOF \nEOF\n"
  Command "cat"
  Redirect "<<"
  HereDocDelimiter "EOF"
  HereDocBody "EOF \n"
  HereDocDelimiter "EOF\n"

"cat <<''\nbody\n\nnext"
  Command "cat"
  Redirect "<<"
  SingleQuoted "''"
  HereDocBody "body\n"
  HereDocDelimiter "\n"
  Command "next"

"cat << -EOF\n-EOF\n"
  Command "cat"
  Redirect "<<"
  HereDocDelimiter "-EOF"
  HereDocDelimiter "-EOF\n"

"x=$(cat <<EOF\ninner )\nEOF\n)\n"
  Assignment "x="
  CommandSub "$("
  Command "cat"
  CommandSub " "
  Redirect "<<"
  HereDocDelimiter "EOF"
  CommandSub "\n"
  HereDocBody "inner )\n"
  HereDocDelimiter "EOF\n"
  CommandSub ")"
