---
source: crates/omsh-syntax/tests/parser.rs
expression: render_tolerant(UNSUPPORTED)
---
"[[ a ]]"
  ERROR Unsupported(DoubleBracket) at "[["
  item "[[ a ]]"
    simple "[[ a ]]"
      word "[["
      word "a"
      word "]]"

"[[ -f x && y ]]"
  ERROR Unsupported(DoubleBracket) at "[["
  item "[[ -f x && y ]]"
    and-or "[[ -f x && y ]]"
      simple "[[ -f x"
        word "[["
        word "-f"
        word "x"
      &&
      simple "y ]]"
        word "y"
        word "]]"

"function f { a; }"
  ERROR Unsupported(FunctionKeyword) at "function"
  ERROR Unexpected { expected: Command } at "}"
  item "function f { a;"
    simple "function f { a"
      word "function"
      word "f"
      word "{"
      word "a"

"function f() { a; }"
  ERROR Unsupported(FunctionKeyword) at "function"
  ERROR Unexpected { expected: CommandEnd } at "("
  ERROR Unexpected { expected: Command } at ")"
  item "function f"
    simple "function f"
      word "function"
      word "f"
  item "{ a; }"
    group "{ a; }"
      item "a;"
        simple "a"
          word "a"

"select i in a b; do c; done"
  ERROR Unsupported(Select) at "select"
  ERROR Unexpected { expected: Command } at "do"
  ERROR Unexpected { expected: Command } at "done"
  item "select i in a b;"
    simple "select i in a b"
      word "select"
      word "i"
      word "in"
      word "a"
      word "b"
  item "c;"
    simple "c"
      word "c"

"coproc a"
  ERROR Unsupported(Coprocess) at "coproc"
  item "coproc a"
    simple "coproc a"
      word "coproc"
      word "a"

"shopt -s extglob"
  ERROR Unsupported(Shopt) at "shopt"
  item "shopt -s extglob"
    simple "shopt -s extglob"
      word "shopt"
      word "-s"
      word "extglob"

"((i++))"
  ERROR Unsupported(ArithmeticCommand) at "((i++))"
  item "((i++))"
    subshell "((i++))"
      item "(i++)"
        subshell "(i++)"
          item "i++"
            simple "i++"
              word "i++"

"(( i = 1 ))"
  ERROR Unsupported(ArithmeticCommand) at "(( i = 1 ))"
  item "(( i = 1 ))"
    subshell "(( i = 1 ))"
      item "( i = 1 )"
        subshell "( i = 1 )"
          item "i = 1"
            simple "i = 1"
              word "i"
              word "="
              word "1"

"((a))"
  ERROR Unsupported(ArithmeticCommand) at "((a))"
  item "((a))"
    subshell "((a))"
      item "(a)"
        subshell "(a)"
          item "a"
            simple "a"
              word "a"

"a |& b"
  ERROR Unsupported(PipeStderr) at "|&"
  item "a |&" background
    simple "a"
      word "a"
  item "b"
    simple "b"
      word "b"

"case x in a) b;& c) d;; esac"
  ERROR Unsupported(CaseFallthrough) at ";&"
  ERROR Unexpected { expected: Reserved(Esac) } at ")"
  ERROR Unexpected { expected: Command } at ";;"
  ERROR Unexpected { expected: Command } at "esac"
  item "case x in a) b;& c"
    case "case x in a) b;& c"
      word "x"
      arm "a) b;& c"
        pattern "a"
        item "b;"
          simple "b"
            word "b"
        item "c"
          simple "c"
            word "c"
  item "d"
    simple "d"
      word "d"

"case x in a) b;;& c) d;; esac"
  ERROR Unsupported(CaseFallthrough) at ";;&"
  ERROR Unexpected { expected: Command } at ")"
  ERROR Unexpected { expected: Command } at ";;"
  ERROR Unexpected { expected: Command } at "esac"
  item "case x in a) b;;&" background
    case "case x in a) b;;"
      word "x"
      arm "a) b"
        pattern "a"
        item "b"
          simple "b"
            word "b"
  item "c"
    simple "c"
      word "c"
  item "d"
    simple "d"
      word "d"

"diff <(a) <(b)"
  ERROR Unsupported(ProcessSubstitution) at "<("
  ERROR Unexpected { expected: Command } at ")"
  ERROR Unsupported(ProcessSubstitution) at "<("
  ERROR Unexpected { expected: Command } at ")"
  item "diff <"
    simple "diff <"
      word "diff"
  item "<"
    simple "<"

"a > >(b)"
  ERROR Unsupported(ProcessSubstitution) at ">("
  ERROR Unexpected { expected: Command } at ")"
  item "a > >"
    simple "a > >"
      word "a"

"a=(1 2)"
  ERROR Unsupported(Array) at "a=("
  ERROR Unexpected { expected: Command } at ")"
  item "a="
    simple "a="
      assign "a=" name="a" at "a"
        value ""

"a+=(3)"
  ERROR Unsupported(Array) at "a+=("
  ERROR Unexpected { expected: Command } at ")"
  item "a+="
    simple "a+="
      word "a+="

"a[0]=x"
  ERROR Unsupported(Array) at "a[0]=x"
  item "a[0]=x"
    simple "a[0]=x"
      word "a[0]=x"

"a+=b"
  ERROR Unsupported(AppendAssignment) at "a+=b"
  item "a+=b"
    simple "a+=b"
      word "a+=b"

"x=1 a+=b"
  ERROR Unsupported(AppendAssignment) at "a+=b"
  item "x=1 a+=b"
    simple "x=1 a+=b"
      assign "x=1" name="x" at "x"
        value "1"
      word "a+=b"

"echo {a,b}"
  ERROR Unsupported(BraceExpansion) at "{a,b}"
  item "echo {a,b}"
    simple "echo {a,b}"
      word "echo"
      word "{a,b}"

"echo a{b,c}d"
  ERROR Unsupported(BraceExpansion) at "a{b,c}d"
  item "echo a{b,c}d"
    simple "echo a{b,c}d"
      word "echo"
      word "a{b,c}d"

"echo {1..3} {a..e} {1..9..2}"
  ERROR Unsupported(BraceExpansion) at "{1..3}"
  ERROR Unsupported(BraceExpansion) at "{a..e}"
  ERROR Unsupported(BraceExpansion) at "{1..9..2}"
  item "echo {1..3} {a..e} {1..9..2}"
    simple "echo {1..3} {a..e} {1..9..2}"
      word "echo"
      word "{1..3}"
      word "{a..e}"
      word "{1..9..2}"

"echo {$a,b}"
  ERROR Unsupported(BraceExpansion) at "{$a,b}"
  item "echo {$a,b}"
    simple "echo {$a,b}"
      word "echo"
      word "{$a,b}"
        literal "{"
        param "$a" name="a" at "a"
        literal ",b}"

"for i in {1..3}; do a; done"
  ERROR Unsupported(BraceExpansion) at "{1..3}"
  item "for i in {1..3}; do a; done"
    for "for i in {1..3}; do a; done" name="i" at "i"
      in
        word "{1..3}"
      do
        item "a;"
          simple "a"
            word "a"

"echo ${x//a/b}"
  ERROR Unsupported(PatternSubstitution) at "${x//a/b}"
  item "echo ${x//a/b}"
    simple "echo ${x//a/b}"
      word "echo"
      word "${x//a/b}"
        param "${x//a/b}" name="x" at "x" Unsupported at ""
          literal "//a/b"

"echo ${x:1:2}"
  ERROR Unsupported(Substring) at "${x:1:2}"
  item "echo ${x:1:2}"
    simple "echo ${x:1:2}"
      word "echo"
      word "${x:1:2}"
        param "${x:1:2}" name="x" at "x" Unsupported at ""
          literal ":1:2"

"echo ${x:1}"
  ERROR Unsupported(Substring) at "${x:1}"
  item "echo ${x:1}"
    simple "echo ${x:1}"
      word "echo"
      word "${x:1}"
        param "${x:1}" name="x" at "x" Unsupported at ""
          literal ":1"

"echo ${x^^} ${x,,}"
  ERROR Unsupported(CaseModification) at "${x^^}"
  ERROR Unsupported(CaseModification) at "${x,,}"
  item "echo ${x^^} ${x,,}"
    simple "echo ${x^^} ${x,,}"
      word "echo"
      word "${x^^}"
        param "${x^^}" name="x" at "x" Unsupported at ""
          literal "^^"
      word "${x,,}"
        param "${x,,}" name="x" at "x" Unsupported at ""
          literal ",,"

"echo ${!x}"
  ERROR Unsupported(Indirection) at "${!x}"
  item "echo ${!x}"
    simple "echo ${!x}"
      word "echo"
      word "${!x}"
        param "${!x}" name="!" at "!" Unsupported at ""
          literal "x"

"echo ${x@Q}"
  ERROR Unsupported(Transformation) at "${x@Q}"
  item "echo ${x@Q}"
    simple "echo ${x@Q}"
      word "echo"
      word "${x@Q}"
        param "${x@Q}" name="x" at "x" Unsupported at ""
          literal "@Q"

"echo ${x[0]} ${#x[@]}"
  ERROR Unsupported(Array) at "${x[0]}"
  ERROR Unsupported(Array) at "${#x[@]}"
  item "echo ${x[0]} ${#x[@]}"
    simple "echo ${x[0]} ${#x[@]}"
      word "echo"
      word "${x[0]}"
        param "${x[0]}" name="x" at "x" Unsupported at ""
          literal "[0]"
      word "${#x[@]}"
        param "${#x[@]}" name="x" at "x" length Unsupported at ""
          literal "[@]"

"echo \"${x//a/b}\""
  ERROR Unsupported(PatternSubstitution) at "${x//a/b}"
  item "echo \"${x//a/b}\""
    simple "echo \"${x//a/b}\""
      word "echo"
      word "\"${x//a/b}\""
        double "\"${x//a/b}\""
          param "${x//a/b}" name="x" at "x" Unsupported at ""
            literal "//a/b"

"echo ${x:-${y//a/b}}"
  ERROR Unsupported(PatternSubstitution) at "${y//a/b}"
  item "echo ${x:-${y//a/b}}"
    simple "echo ${x:-${y//a/b}}"
      word "echo"
      word "${x:-${y//a/b}}"
        param "${x:-${y//a/b}}" name="x" at "x" ColonDash at ":-"
          param "${y//a/b}" name="y" at "y" Unsupported at ""
            literal "//a/b"

"echo $((${x//a/b}))"
  ERROR Unsupported(PatternSubstitution) at "${x//a/b}"
  item "echo $((${x//a/b}))"
    simple "echo $((${x//a/b}))"
      word "echo"
      word "$((${x//a/b}))"
        arithmetic "$((${x//a/b}))"
          param "${x//a/b}" name="x" at "x" Unsupported at ""
            literal "//a/b"

"$(<file)"
  ERROR Unsupported(FileContents) at "$(<file)"
  item "$(<file)"
    simple "$(<file)"
      word "$(<file)"
        command-sub "$(<file)"
          item "<file"
            simple "<file"
              redirect "<file" Input
                target "file"

"echo `<file`"
  ERROR Unsupported(FileContents) at "`<file`"
  item "echo `<file`"
    simple "echo `<file`"
      word "echo"
      word "`<file`"
        command-sub "`<file`"
          item "<file"
            simple "<file"
              redirect "<file" Input
                target "file"

"echo \"$(< file)\""
  ERROR Unsupported(FileContents) at "$(< file)"
  item "echo \"$(< file)\""
    simple "echo \"$(< file)\""
      word "echo"
      word "\"$(< file)\""
        double "\"$(< file)\""
          command-sub "$(< file)"
            item "< file"
              simple "< file"
                redirect "< file" Input
                  target "file"

"cat <<EOF\n${x//a/b}\nEOF\n"
  ERROR Unsupported(PatternSubstitution) at "${x//a/b}"
  item "cat <<EOF"
    simple "cat <<EOF"
      word "cat"
      here-doc "<<EOF" delimiter="EOF"
        body "${x//a/b}\n"
          param "${x//a/b}" name="x" at "x" Unsupported at ""
            literal "//a/b"
          literal "\n"
