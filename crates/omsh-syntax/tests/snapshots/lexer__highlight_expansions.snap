---
source: crates/omsh-syntax/tests/lexer.rs
expression: render_highlight(lines)
---
"~ ~user ~/x a~ \"~\""
  Command "~"
  Argument "~user"
  Argument "~/x"
  Argument "a~"
  DoubleQuoted "\"~\""

"$VAR ${VAR} $_a1 $é"
  Variable "$VAR"
  Variable "${VAR}"
  Variable "$_a1"
  Argument "$é"

"${VAR:-x} ${VAR:=x} ${VAR:?msg} ${VAR:+x}"
  Variable "${VAR:-x}"
  Variable "${VAR:=x}"
  Variable "${VAR:?msg}"
  Variable "${VAR:+x}"

"${VAR-x} ${VAR=x} ${VAR?msg} ${VAR+x}"
  Variable "${VAR-x}"
  Variable "${VAR=x}"
  Variable "${VAR?msg}"
  Variable "${VAR+x}"

"${VAR#p} ${VAR##p} ${VAR%p} ${VAR%%p}"
  Variable "${VAR#p}"
  Variable "${VAR##p}"
  Variable "${VAR%p}"
  Variable "${VAR%%p}"

"${#VAR} ${#} ${##} ${#?} ${#-} ${#1} ${#@}"
  Variable "${#VAR}"
  Variable "${#}"
  Variable "${##}"
  Variable "${#?}"
  Variable "${#-}"
  Variable "${#1}"
  Variable "${#@}"

"${#-x} ${#:-x} ${##x} ${#%x}"
  Variable "${#-x}"
  Variable "${#:-x}"
  Variable "${##x}"
  Variable "${#%x}"

"$? $$ $! $0 $# $@ $* $- $1 $9 $10 ${10}"
  Variable "$?"
  Variable "$$"
  Variable "$!"
  Variable "$0"
  Variable "$#"
  Variable "$@"
  Variable "$*"
  Variable "$-"
  Variable "$1"
  Variable "$9"
  Variable "$1"
  Argument "0"
  Variable "${10}"

"${VAR:-a b} ${VAR:-$OTHER} ${VAR:-${INNER:-$(cmd)}}"
  Variable "${VAR:-a b}"
  Variable "${VAR:-$OTHER}"
  Variable "${VAR:-${INNER:-"
  CommandSub "$("
  Command "cmd"
  CommandSub ")"
  Variable "}}"

"${VAR:-'a}b'} \"${VAR:-it's}\" \"${VAR#'a'}\" \"${VAR:-a\\}b}\""
  Variable "${VAR:-"
  SingleQuoted "'a}b'"
  Variable "}"
  DoubleQuoted "\""
  Variable "${VAR:-it's}"
  DoubleQuoted "\""
  DoubleQuoted "\""
  Variable "${VAR#"
  SingleQuoted "'a'"
  Variable "}"
  DoubleQuoted "\""
  DoubleQuoted "\""
  Variable "${VAR:-a"
  Escape "\\}"
  Variable "b}"
  DoubleQuoted "\""

"\"${VAR:-\"a b\"}\""
  DoubleQuoted "\""
  Variable "${VAR:-"
  DoubleQuoted "\"a b\""
  Variable "}"
  DoubleQuoted "\""

"$(cmd arg)x $(a $(b \"$(c)\")) \"$(d e)\""
  CommandSub "$("
  Command "cmd"
  CommandSub " "
  Argument "arg"
  CommandSub ")"
  Command "x"
  CommandSub "$("
  Command "a"
  CommandSub " $("
  Command "b"
  CommandSub " "
  DoubleQuoted "\""
  CommandSub "$("
  Command "c"
  CommandSub ")"
  DoubleQuoted "\""
  CommandSub "))"
  DoubleQuoted "\""
  CommandSub "$("
  Command "d"
  CommandSub " "
  Argument "e"
  CommandSub ")"
  DoubleQuoted "\""

"$(echo \")\") $(echo ')') $(echo \\))"
  CommandSub "$("
  Command "echo"
  CommandSub " "
  DoubleQuoted "\")\""
  CommandSub ")"
  CommandSub "$("
  Command "echo"
  CommandSub " "
  SingleQuoted "')'"
  CommandSub ")"
  CommandSub "$("
  Command "echo"
  CommandSub " "
  Escape "\\)"
  CommandSub ")"

"$(a # )\n)"
  CommandSub "$("
  Command "a"
  CommandSub " "
  Comment "# )"
  CommandSub "\n)"

"$(case x in a) b;; esac) $(case x in (a) b;; esac)"
  CommandSub "$("
  Keyword "case"
  CommandSub " "
  Argument "x"
  CommandSub " "
  Keyword "in"
  CommandSub " "
  Argument "a"
  Operator ")"
  CommandSub " "
  Command "b"
  Separator ";;"
  CommandSub " "
  Keyword "esac"
  CommandSub ")"
  CommandSub "$("
  Keyword "case"
  CommandSub " "
  Argument "x"
  CommandSub " "
  Keyword "in"
  CommandSub " "
  Operator "("
  Argument "a"
  Operator ")"
  CommandSub " "
  Command "b"
  Separator ";;"
  CommandSub " "
  Keyword "esac"
  CommandSub ")"

"$( (case x in a) b;; esac) ) $(echo case) $(case esac in a|b) c; esac)"
  CommandSub "$( "
  Operator "("
  Keyword "case"
  CommandSub " "
  Argument "x"
  CommandSub " "
  Keyword "in"
  CommandSub " "
  Argument "a"
  Operator ")"
  CommandSub " "
  Command "b"
  Separator ";;"
  CommandSub " "
  Keyword "esac"
  Operator ")"
  CommandSub " )"
  CommandSub "$("
  Command "echo"
  CommandSub " "
  Argument "case"
  CommandSub ")"
  CommandSub "$("
  Keyword "case"
  CommandSub " "
  Argument "esac"
  CommandSub " "
  Keyword "in"
  CommandSub " "
  Argument "a"
  Operator "|"
  Argument "b"
  Operator ")"
  CommandSub " "
  Command "c"
  Separator ";"
  CommandSub " "
  Keyword "esac"
  CommandSub ")"

"`cmd arg` \"`a`\" `a \\` b`"
  CommandSub "`cmd arg`"
  DoubleQuoted "\""
  CommandSub "`a`"
  DoubleQuoted "\""
  CommandSub "`a \\` b`"

"$((1 + 2)) $(( (1 + 2) * $x )) $(($(a) + ${b:-1})) $(())"
  Arithmetic "$((1 + 2))"
  Arithmetic "$(( (1 + 2) * "
  Variable "$x"
  Arithmetic " ))"
  Arithmetic "$(("
  CommandSub "$("
  Command "a"
  CommandSub ")"
  Arithmetic " + "
  Variable "${b:-1}"
  Arithmetic "))"
  Arithmetic "$(())"

"$((a) ) $((a); (b)) $((echo ')'))"
  CommandSub "$("
  Operator "("
  Command "a"
  Operator ")"
  CommandSub " )"
  CommandSub "$("
  Operator "("
  Command "a"
  Operator ")"
  Separator ";"
  CommandSub " "
  Operator "("
  Command "b"
  Operator ")"
  CommandSub ")"
  Arithmetic "$((echo ')'))"

"* ?.txt [abc] [!abc] \"*\" \\*"
  Command "*"
  Argument "?.txt"
  Argument "[abc]"
  Argument "[!abc]"
  DoubleQuoted "\"*\""
  Escape "\\*"

"a$\\\nb $\\\n(c) ${\\\nd} $e\\\nf"
  Command "a"
  Variable "$\\\nb"
  CommandSub "$\\\n("
  Command "c"
  CommandSub ")"
  Variable "${\\\nd}"
  Variable "$e\\\nf"
