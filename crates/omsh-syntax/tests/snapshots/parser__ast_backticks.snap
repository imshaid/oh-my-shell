---
source: crates/omsh-syntax/tests/parser.rs
expression: render_lines(lines)
---
"`a`"
  item "`a`"
    simple "`a`"
      word "`a`"
        command-sub "`a`"
          item "a"
            simple "a"
              word "a"

"``"
  item "``"
    simple "``"
      word "``"
        command-sub "``"

"` `"
  item "` `"
    simple "` `"
      word "` `"
        command-sub "` `"

"`a | b; c`"
  item "`a | b; c`"
    simple "`a | b; c`"
      word "`a | b; c`"
        command-sub "`a | b; c`"
          item "a | b;"
            pipeline "a | b"
              simple "a"
                word "a"
              simple "b"
                word "b"
          item "c"
            simple "c"
              word "c"

"x`a`y"
  item "x`a`y"
    simple "x`a`y"
      word "x`a`y"
        literal "x"
        command-sub "`a`"
          item "a"
            simple "a"
              word "a"
        literal "y"

"`if a; then b; fi`"
  item "`if a; then b; fi`"
    simple "`if a; then b; fi`"
      word "`if a; then b; fi`"
        command-sub "`if a; then b; fi`"
          item "if a; then b; fi"
            if "if a; then b; fi"
              branch "if a; then b;"
                condition
                  item "a;"
                    simple "a"
                      word "a"
                then
                  item "b;"
                    simple "b"
                      word "b"

"`a $(b)`"
  item "`a $(b)`"
    simple "`a $(b)`"
      word "`a $(b)`"
        command-sub "`a $(b)`"
          item "a $(b)"
            simple "a $(b)"
              word "a"
              word "$(b)"
                command-sub "$(b)"
                  item "b"
                    simple "b"
                      word "b"

"$(a `b`)"
  item "$(a `b`)"
    simple "$(a `b`)"
      word "$(a `b`)"
        command-sub "$(a `b`)"
          item "a `b`"
            simple "a `b`"
              word "a"
              word "`b`"
                command-sub "`b`"
                  item "b"
                    simple "b"
                      word "b"

"`echo \\$x`"
  item "`echo \\$x`"
    simple "`echo \\$x`"
      word "`echo \\$x`"
        command-sub "`echo \\$x`"
          item "echo \\$x"
            simple "echo \\$x"
              word "echo"
              word "$x"
                param "$x" name="x" at "x"

"`echo $x`"
  item "`echo $x`"
    simple "`echo $x`"
      word "`echo $x`"
        command-sub "`echo $x`"
          item "echo $x"
            simple "echo $x"
              word "echo"
              word "$x"
                param "$x" name="x" at "x"

"`echo a\\$`"
  item "`echo a\\$`"
    simple "`echo a\\$`"
      word "`echo a\\$`"
        command-sub "`echo a\\$`"
          item "echo a\\$"
            simple "echo a\\$"
              word "echo"
              word "a\\$"
                literal "a$" at "a\\$"

"`echo a\\\\b`"
  item "`echo a\\\\b`"
    simple "`echo a\\\\b`"
      word "`echo a\\\\b`"
        command-sub "`echo a\\\\b`"
          item "echo a\\\\b"
            simple "echo a\\\\b"
              word "echo"
              word "a\\\\b"
                literal "a"
                escaped "b" at "\\b"

"`echo a\\\\\\$b`"
  item "`echo a\\\\\\$b`"
    simple "`echo a\\\\\\$b`"
      word "`echo a\\\\\\$b`"
        command-sub "`echo a\\\\\\$b`"
          item "echo a\\\\\\$b"
            simple "echo a\\\\\\$b"
              word "echo"
              word "a\\\\\\$b"
                literal "a"
                escaped "$" at "\\\\$"
                literal "b"

"`echo \\q`"
  item "`echo \\q`"
    simple "`echo \\q`"
      word "`echo \\q`"
        command-sub "`echo \\q`"
          item "echo \\q"
            simple "echo \\q"
              word "echo"
              word "\\q"
                escaped "q" at "\\q"

"`a \\`b\\``"
  item "`a \\`b\\``"
    simple "`a \\`b\\``"
      word "`a \\`b\\``"
        command-sub "`a \\`b\\``"
          item "a \\`b\\`"
            simple "a \\`b\\`"
              word "a"
              word "`b\\`"
                command-sub "`b\\`"
                  item "b"
                    simple "b"
                      word "b"

"`a \\`b \\\\\\`c\\\\\\`\\``"
  item "`a \\`b \\\\\\`c\\\\\\`\\``"
    simple "`a \\`b \\\\\\`c\\\\\\`\\``"
      word "`a \\`b \\\\\\`c\\\\\\`\\``"
        command-sub "`a \\`b \\\\\\`c\\\\\\`\\``"
          item "a \\`b \\\\\\`c\\\\\\`\\`"
            simple "a \\`b \\\\\\`c\\\\\\`\\`"
              word "a"
              word "`b \\\\\\`c\\\\\\`\\`"
                command-sub "`b \\\\\\`c\\\\\\`\\`"
                  item "b \\\\\\`c\\\\\\`"
                    simple "b \\\\\\`c\\\\\\`"
                      word "b"
                      word "`c\\\\\\`"
                        command-sub "`c\\\\\\`"
                          item "c"
                            simple "c"
                              word "c"

"`a \\\"b\\\"`"
  item "`a \\\"b\\\"`"
    simple "`a \\\"b\\\"`"
      word "`a \\\"b\\\"`"
        command-sub "`a \\\"b\\\"`"
          item "a \\\"b\\\""
            simple "a \\\"b\\\""
              word "a"
              word "\\\"b\\\""
                escaped "\"" at "\\\""
                literal "b"
                escaped "\"" at "\\\""

"\"`a \\\"b c\\\"`\""
  item "\"`a \\\"b c\\\"`\""
    simple "\"`a \\\"b c\\\"`\""
      word "\"`a \\\"b c\\\"`\""
        double "\"`a \\\"b c\\\"`\""
          command-sub "`a \\\"b c\\\"`"
            item "a \\\"b c\\\""
              simple "a \\\"b c\\\""
                word "a"
                word "\"b c\\\""
                  double "\"b c\\\""
                    literal "b c"

"${x:-`a \\\"b\\\"`}"
  item "${x:-`a \\\"b\\\"`}"
    simple "${x:-`a \\\"b\\\"`}"
      word "${x:-`a \\\"b\\\"`}"
        param "${x:-`a \\\"b\\\"`}" name="x" at "x" ColonDash at ":-"
          command-sub "`a \\\"b\\\"`"
            item "a \\\"b\\\""
              simple "a \\\"b\\\""
                word "a"
                word "\\\"b\\\""
                  escaped "\"" at "\\\""
                  literal "b"
                  escaped "\"" at "\\\""

"\"${x:-`a \\\"b\\\"`}\""
  item "\"${x:-`a \\\"b\\\"`}\""
    simple "\"${x:-`a \\\"b\\\"`}\""
      word "\"${x:-`a \\\"b\\\"`}\""
        double "\"${x:-`a \\\"b\\\"`}\""
          param "${x:-`a \\\"b\\\"`}" name="x" at "x" ColonDash at ":-"
            command-sub "`a \\\"b\\\"`"
              item "a \\\"b\\\""
                simple "a \\\"b\\\""
                  word "a"
                  word "\"b\\\""
                    double "\"b\\\""
                      literal "b"

"$((`a \\\"b\\\"`))"
  item "$((`a \\\"b\\\"`))"
    simple "$((`a \\\"b\\\"`))"
      word "$((`a \\\"b\\\"`))"
        arithmetic "$((`a \\\"b\\\"`))"
          command-sub "`a \\\"b\\\"`"
            item "a \\\"b\\\""
              simple "a \\\"b\\\""
                word "a"
                word "\"b\\\""
                  double "\"b\\\""
                    literal "b"

"`a\\\nb`"
  item "`a\\\nb`"
    simple "`a\\\nb`"
      word "`a\\\nb`"
        command-sub "`a\\\nb`"
          item "a\\\nb"
            simple "a\\\nb"
              word "a\\\nb"
                literal "ab" at "a\\\nb"

"`a 'b\\\nc'`"
  item "`a 'b\\\nc'`"
    simple "`a 'b\\\nc'`"
      word "`a 'b\\\nc'`"
        command-sub "`a 'b\\\nc'`"
          item "a 'b\\\nc'"
            simple "a 'b\\\nc'"
              word "a"
              word "'b\\\nc'"
                single "bc" at "'b\\\nc'"

"`é \\$x ব\u{9be}ংল\u{9be}`"
  item "`é \\$x ব\u{9be}ংল\u{9be}`"
    simple "`é \\$x ব\u{9be}ংল\u{9be}`"
      word "`é \\$x ব\u{9be}ংল\u{9be}`"
        command-sub "`é \\$x ব\u{9be}ংল\u{9be}`"
          item "é \\$x ব\u{9be}ংল\u{9be}"
            simple "é \\$x ব\u{9be}ংল\u{9be}"
              word "é"
              word "$x"
                param "$x" name="x" at "x"
              word "ব\u{9be}ংল\u{9be}"

"A=`b`"
  item "A=`b`"
    simple "A=`b`"
      assign "A=`b`" name="A" at "A"
        value "`b`"
          command-sub "`b`"
            item "b"
              simple "b"
                word "b"

"`cat <<E`"
  item "`cat <<E`"
    simple "`cat <<E`"
      word "`cat <<E`"
        command-sub "`cat <<E`"
          item "cat <<E"
            simple "cat <<E"
              word "cat"
              here-doc "<<E" delimiter="E"
                body ""

"`cat <<E\nbody`"
  item "`cat <<E\nbody`"
    simple "`cat <<E\nbody`"
      word "`cat <<E\nbody`"
        command-sub "`cat <<E\nbody`"
          item "cat <<E"
            simple "cat <<E"
              word "cat"
              here-doc "<<E" delimiter="E"
                body "body"
                  literal "body"

"`a\\\\`"
  item "`a\\\\`"
    simple "`a\\\\`"
      word "`a\\\\`"
        command-sub "`a\\\\`"
          item "a\\\\"
            simple "a\\\\"
              word "a\\\\"
                literal "a"
                escaped "\\"
