---
source: crates/omsh-syntax/tests/parser.rs
expression: render_lines(lines)
---
"f() { a; }"
  item "f() { a; }"
    function "f() { a; }" name="f" at "f"
      group "{ a; }"
        item "a;"
          simple "a"
            word "a"

"f ( ) { a; }"
  item "f ( ) { a; }"
    function "f ( ) { a; }" name="f" at "f"
      group "{ a; }"
        item "a;"
          simple "a"
            word "a"

"f()\n\n{ a; }"
  item "f()\n\n{ a; }"
    function "f()\n\n{ a; }" name="f" at "f"
      group "{ a; }"
        item "a;"
          simple "a"
            word "a"

"f() (a)"
  item "f() (a)"
    function "f() (a)" name="f" at "f"
      subshell "(a)"
        item "a"
          simple "a"
            word "a"

"f() if a; then b; fi"
  item "f() if a; then b; fi"
    function "f() if a; then b; fi" name="f" at "f"
      if "if a; then b; fi"
        branch "if a; then b;"
          condition
            item "a;"
              simple "a"
                word "a"
          then
            item "b;"
              simple "b"
                word "b"

"f() { a; } >x"
  item "f() { a; } >x"
    function "f() { a; } >x" name="f" at "f"
      group "{ a; } >x"
        item "a;"
          simple "a"
            word "a"
        redirect ">x" Output
          target "x"

"f() a"
  item "f() a"
    function "f() a" name="f" at "f"
      simple "a"
        word "a"

"f() a=1"
  item "f() a=1"
    function "f() a=1" name="f" at "f"
      simple "a=1"
        assign "a=1" name="a" at "a"
          value "1"

"f() >x"
  item "f() >x"
    function "f() >x" name="f" at "f"
      simple ">x"
        redirect ">x" Output
          target "x"

"f() a >x | b"
  item "f() a >x | b"
    pipeline "f() a >x | b"
      function "f() a >x" name="f" at "f"
        simple "a >x"
          word "a"
          redirect ">x" Output
            target "x"
      simple "b"
        word "b"

"f() g() { a; }"
  item "f() g() { a; }"
    function "f() g() { a; }" name="f" at "f"
      function "g() { a; }" name="g" at "g"
        group "{ a; }"
          item "a;"
            simple "a"
              word "a"

"f() { a; } | b"
  item "f() { a; } | b"
    pipeline "f() { a; } | b"
      function "f() { a; }" name="f" at "f"
        group "{ a; }"
          item "a;"
            simple "a"
              word "a"
      simple "b"
        word "b"

"f() { a; } && b"
  item "f() { a; } && b"
    and-or "f() { a; } && b"
      function "f() { a; }" name="f" at "f"
        group "{ a; }"
          item "a;"
            simple "a"
              word "a"
      &&
      simple "b"
        word "b"

"f\\\ng() { a; }"
  item "f\\\ng() { a; }"
    function "f\\\ng() { a; }" name="fg" at "f\\\ng"
      group "{ a; }"
        item "a;"
          simple "a"
            word "a"

"_a1() { a; }"
  item "_a1() { a; }"
    function "_a1() { a; }" name="_a1" at "_a1"
      group "{ a; }"
        item "a;"
          simple "a"
            word "a"

"echo() { a; }"
  item "echo() { a; }"
    function "echo() { a; }" name="echo" at "echo"
      group "{ a; }"
        item "a;"
          simple "a"
            word "a"

"f() { g() { a; }; }"
  item "f() { g() { a; }; }"
    function "f() { g() { a; }; }" name="f" at "f"
      group "{ g() { a; }; }"
        item "g() { a; };"
          function "g() { a; }" name="g" at "g"
            group "{ a; }"
              item "a;"
                simple "a"
                  word "a"

"f() # note\n{ a; }"
  item "f() # note\n{ a; }"
    function "f() # note\n{ a; }" name="f" at "f"
      group "{ a; }"
        item "a;"
          simple "a"
            word "a"

"f(\\\n) { a; }"
  item "f(\\\n) { a; }"
    function "f(\\\n) { a; }" name="f" at "f"
      group "{ a; }"
        item "a;"
          simple "a"
            word "a"

"{ # note\n a; }"
  item "{ # note\n a; }"
    group "{ # note\n a; }"
      item "a;"
        simple "a"
          word "a"

"( # note\n a )"
  item "( # note\n a )"
    subshell "( # note\n a )"
      item "a"
        simple "a"
          word "a"
