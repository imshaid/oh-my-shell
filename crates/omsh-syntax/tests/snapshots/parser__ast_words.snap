---
source: crates/omsh-syntax/tests/parser.rs
expression: render_lines(lines)
---
"'a b'"
  item "'a b'"
    simple "'a b'"
      word "'a b'"
        single "a b" at "'a b'"

"\"a b\""
  item "\"a b\""
    simple "\"a b\""
      word "\"a b\""
        double "\"a b\""
          literal "a b"

"a\\ b \\$x \\\\"
  item "a\\ b \\$x \\\\"
    simple "a\\ b \\$x \\\\"
      word "a\\ b"
        literal "a"
        escaped " " at "\\ "
        literal "b"
      word "\\$x"
        escaped "$" at "\\$"
        literal "x"
      word "\\\\"
        escaped "\\" at "\\\\"

"\\é"
  item "\\é"
    simple "\\é"
      word "\\é"
        escaped "é" at "\\é"

"a'b'\"c\"d"
  item "a'b'\"c\"d"
    simple "a'b'\"c\"d"
      word "a'b'\"c\"d"
        literal "a"
        single "b" at "'b'"
        double "\"c\""
          literal "c"
        literal "d"

"\"\\q \\$ \\` \\\" \\\\\""
  item "\"\\q \\$ \\` \\\" \\\\\""
    simple "\"\\q \\$ \\` \\\" \\\\\""
      word "\"\\q \\$ \\` \\\" \\\\\""
        double "\"\\q \\$ \\` \\\" \\\\\""
          literal "\\q "
          escaped "$" at "\\$"
          literal " "
          escaped "`" at "\\`"
          literal " "
          escaped "\"" at "\\\""
          literal " "
          escaped "\\" at "\\\\"

"''  \"\""
  item "''  \"\""
    simple "''  \"\""
      word "''"
        single "" at "''"
      word "\"\""
        double "\"\""

"a\\\nb"
  item "a\\\nb"
    simple "a\\\nb"
      word "a\\\nb"
        literal "ab" at "a\\\nb"

"\"a\\\nb\""
  item "\"a\\\nb\""
    simple "\"a\\\nb\""
      word "\"a\\\nb\""
        double "\"a\\\nb\""
          literal "ab" at "a\\\nb"

"'a\\\nb'"
  item "'a\\\nb'"
    simple "'a\\\nb'"
      word "'a\\\nb'"
        single "a\\\nb" at "'a\\\nb'"

"~ ~user ~/x a~"
  item "~ ~user ~/x a~"
    simple "~ ~user ~/x a~"
      word "~"
      word "~user"
      word "~/x"
      word "a~"

"* ?.txt [abc] [!abc] \"*\" \\*"
  item "* ?.txt [abc] [!abc] \"*\" \\*"
    simple "* ?.txt [abc] [!abc] \"*\" \\*"
      word "*"
      word "?.txt"
      word "[abc]"
      word "[!abc]"
      word "\"*\""
        double "\"*\""
          literal "*"
      word "\\*"
        escaped "*" at "\\*"

"$ a$ \"$\""
  item "$ a$ \"$\""
    simple "$ a$ \"$\""
      word "$"
      word "a$"
      word "\"$\""
        double "\"$\""
          literal "$"

"\"it's\" 'say \"hi\"'"
  item "\"it's\" 'say \"hi\"'"
    simple "\"it's\" 'say \"hi\"'"
      word "\"it's\""
        double "\"it's\""
          literal "it's"
      word "'say \"hi\"'"
        single "say \"hi\"" at "'say \"hi\"'"

"\"a $x `y` $(z) $((1))\""
  item "\"a $x `y` $(z) $((1))\""
    simple "\"a $x `y` $(z) $((1))\""
      word "\"a $x `y` $(z) $((1))\""
        double "\"a $x `y` $(z) $((1))\""
          literal "a "
          param "$x" name="x" at "x"
          literal " "
          command-sub "`y`"
            item "y"
              simple "y"
                word "y"
          literal " "
          command-sub "$(z)"
            item "z"
              simple "z"
                word "z"
          literal " "
          arithmetic "$((1))"
            literal "1"
