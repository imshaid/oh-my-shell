---
source: crates/omsh-syntax/tests/parser.rs
expression: render_failures(UNSUPPORTED)
---
"[[ a ]]"
  Unsupported(DoubleBracket) at "[["
"[[ -f x && y ]]"
  Unsupported(DoubleBracket) at "[["
"function f { a; }"
  Unsupported(FunctionKeyword) at "function"
"function f() { a; }"
  Unsupported(FunctionKeyword) at "function"
"select i in a b; do c; done"
  Unsupported(Select) at "select"
"coproc a"
  Unsupported(Coprocess) at "coproc"
"shopt -s extglob"
  Unsupported(Shopt) at "shopt"
"((i++))"
  Unsupported(ArithmeticCommand) at "((i++))"
"(( i = 1 ))"
  Unsupported(ArithmeticCommand) at "(( i = 1 ))"
"((a))"
  Unsupported(ArithmeticCommand) at "((a))"
"a |& b"
  Unsupported(PipeStderr) at "|&"
"case x in a) b;& c) d;; esac"
  Unsupported(CaseFallthrough) at ";&"
"case x in a) b;;& c) d;; esac"
  Unsupported(CaseFallthrough) at ";;&"
"diff <(a) <(b)"
  Unsupported(ProcessSubstitution) at "<("
"a > >(b)"
  Unsupported(ProcessSubstitution) at ">("
"a=(1 2)"
  Unsupported(Array) at "a=("
"a+=(3)"
  Unsupported(Array) at "a+=("
"a[0]=x"
  Unsupported(Array) at "a[0]=x"
"a+=b"
  Unsupported(AppendAssignment) at "a+=b"
"x=1 a+=b"
  Unsupported(AppendAssignment) at "a+=b"
"echo {a,b}"
  Unsupported(BraceExpansion) at "{a,b}"
"echo a{b,c}d"
  Unsupported(BraceExpansion) at "a{b,c}d"
"echo {1..3} {a..e} {1..9..2}"
  Unsupported(BraceExpansion) at "{1..3}"
"echo {$a,b}"
  Unsupported(BraceExpansion) at "{$a,b}"
"for i in {1..3}; do a; done"
  Unsupported(BraceExpansion) at "{1..3}"
"echo ${x//a/b}"
  Unsupported(PatternSubstitution) at "${x//a/b}"
"echo ${x:1:2}"
  Unsupported(Substring) at "${x:1:2}"
"echo ${x:1}"
  Unsupported(Substring) at "${x:1}"
"echo ${x^^} ${x,,}"
  Unsupported(CaseModification) at "${x^^}"
"echo ${!x}"
  Unsupported(Indirection) at "${!x}"
"echo ${x@Q}"
  Unsupported(Transformation) at "${x@Q}"
"echo ${x[0]} ${#x[@]}"
  Unsupported(Array) at "${x[0]}"
"echo \"${x//a/b}\""
  Unsupported(PatternSubstitution) at "${x//a/b}"
"echo ${x:-${y//a/b}}"
  Unsupported(PatternSubstitution) at "${y//a/b}"
"echo $((${x//a/b}))"
  Unsupported(PatternSubstitution) at "${x//a/b}"
"$(<file)"
  Unsupported(FileContents) at "$(<file)"
"echo `<file`"
  Unsupported(FileContents) at "`<file`"
"echo \"$(< file)\""
  Unsupported(FileContents) at "$(< file)"
"cat <<EOF\n${x//a/b}\nEOF\n"
  Unsupported(PatternSubstitution) at "${x//a/b}"
