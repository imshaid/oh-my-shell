---
source: crates/omsh-syntax/tests/parser.rs
expression: render_lines(lines)
---
"if a; then b; fi"
  item "if a; then b; fi"
    if "if a; then b; fi"
      branch "if a; then b;"
        condition
          item "a;"
            simple "a"
              word "a"
        then
          item "b;"
            simple "b"
              word "b"

"if a; then b; else c; fi"
  item "if a; then b; else c; fi"
    if "if a; then b; else c; fi"
      branch "if a; then b;"
        condition
          item "a;"
            simple "a"
              word "a"
        then
          item "b;"
            simple "b"
              word "b"
      else
        item "c;"
          simple "c"
            word "c"

"if a; then b; elif c; then d; else e; fi"
  item "if a; then b; elif c; then d; else e; fi"
    if "if a; then b; elif c; then d; else e; fi"
      branch "if a; then b;"
        condition
          item "a;"
            simple "a"
              word "a"
        then
          item "b;"
            simple "b"
              word "b"
      branch "elif c; then d;"
        condition
          item "c;"
            simple "c"
              word "c"
        then
          item "d;"
            simple "d"
              word "d"
      else
        item "e;"
          simple "e"
            word "e"

"if a; then b; elif c; then d; elif e; then f; fi"
  item "if a; then b; elif c; then d; elif e; then f; fi"
    if "if a; then b; elif c; then d; elif e; then f; fi"
      branch "if a; then b;"
        condition
          item "a;"
            simple "a"
              word "a"
        then
          item "b;"
            simple "b"
              word "b"
      branch "elif c; then d;"
        condition
          item "c;"
            simple "c"
              word "c"
        then
          item "d;"
            simple "d"
              word "d"
      branch "elif e; then f;"
        condition
          item "e;"
            simple "e"
              word "e"
        then
          item "f;"
            simple "f"
              word "f"

"if a\nthen\n b\nfi"
  item "if a\nthen\n b\nfi"
    if "if a\nthen\n b\nfi"
      branch "if a\nthen\n b"
        condition
          item "a"
            simple "a"
              word "a"
        then
          item "b"
            simple "b"
              word "b"

"if\n a\nthen\n b\nelse\n c\nfi"
  item "if\n a\nthen\n b\nelse\n c\nfi"
    if "if\n a\nthen\n b\nelse\n c\nfi"
      branch "if\n a\nthen\n b"
        condition
          item "a"
            simple "a"
              word "a"
        then
          item "b"
            simple "b"
              word "b"
      else
        item "c"
          simple "c"
            word "c"

"if a; b; then c; d; fi"
  item "if a; b; then c; d; fi"
    if "if a; b; then c; d; fi"
      branch "if a; b; then c; d;"
        condition
          item "a;"
            simple "a"
              word "a"
          item "b;"
            simple "b"
              word "b"
        then
          item "c;"
            simple "c"
              word "c"
          item "d;"
            simple "d"
              word "d"

"if a; then b; fi >f"
  item "if a; then b; fi >f"
    if "if a; then b; fi >f"
      branch "if a; then b;"
        condition
          item "a;"
            simple "a"
              word "a"
        then
          item "b;"
            simple "b"
              word "b"
      redirect ">f" Output
        target "f"

"if a; then b; fi | c"
  item "if a; then b; fi | c"
    pipeline "if a; then b; fi | c"
      if "if a; then b; fi"
        branch "if a; then b;"
          condition
            item "a;"
              simple "a"
                word "a"
          then
            item "b;"
              simple "b"
                word "b"
      simple "c"
        word "c"

"if a; then if b; then c; fi fi"
  item "if a; then if b; then c; fi fi"
    if "if a; then if b; then c; fi fi"
      branch "if a; then if b; then c; fi"
        condition
          item "a;"
            simple "a"
              word "a"
        then
          item "if b; then c; fi"
            if "if b; then c; fi"
              branch "if b; then c;"
                condition
                  item "b;"
                    simple "b"
                      word "b"
                then
                  item "c;"
                    simple "c"
                      word "c"

"if ! a; then b; fi"
  item "if ! a; then b; fi"
    if "if ! a; then b; fi"
      branch "if ! a; then b;"
        condition
          item "! a;"
            pipeline "! a" negated
              simple "a"
                word "a"
        then
          item "b;"
            simple "b"
              word "b"

"if (a); then { b; }; fi"
  item "if (a); then { b; }; fi"
    if "if (a); then { b; }; fi"
      branch "if (a); then { b; };"
        condition
          item "(a);"
            subshell "(a)"
              item "a"
                simple "a"
                  word "a"
        then
          item "{ b; };"
            group "{ b; }"
              item "b;"
                simple "b"
                  word "b"

"i\\\nf a; then b; f\\\ni"
  item "i\\\nf a; then b; f\\\ni"
    if "i\\\nf a; then b; f\\\ni"
      branch "i\\\nf a; then b;"
        condition
          item "a;"
            simple "a"
              word "a"
        then
          item "b;"
            simple "b"
              word "b"

"if # note\n a # note\nthen # note\n b # note\nelse # note\n c # note\nfi # note"
  item "if # note\n a # note\nthen # note\n b # note\nelse # note\n c # note\nfi"
    if "if # note\n a # note\nthen # note\n b # note\nelse # note\n c # note\nfi"
      branch "if # note\n a # note\nthen # note\n b"
        condition
          item "a"
            simple "a"
              word "a"
        then
          item "b"
            simple "b"
              word "b"
      else
        item "c"
          simple "c"
            word "c"

"if \\\n a; then b; fi"
  item "if \\\n a; then b; fi"
    if "if \\\n a; then b; fi"
      branch "if \\\n a; then b;"
        condition
          item "a;"
            simple "a"
              word "a"
        then
          item "b;"
            simple "b"
              word "b"
