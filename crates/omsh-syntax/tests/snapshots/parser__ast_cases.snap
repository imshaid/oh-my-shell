---
source: crates/omsh-syntax/tests/parser.rs
expression: render_lines(lines)
---
"case x in esac"
  item "case x in esac"
    case "case x in esac"
      word "x"

"case x in a) esac"
  item "case x in a) esac"
    case "case x in a) esac"
      word "x"
      arm "a)"
        pattern "a"

"case x in a) b; esac"
  item "case x in a) b; esac"
    case "case x in a) b; esac"
      word "x"
      arm "a) b;"
        pattern "a"
        item "b;"
          simple "b"
            word "b"

"case x in a) b;; esac"
  item "case x in a) b;; esac"
    case "case x in a) b;; esac"
      word "x"
      arm "a) b"
        pattern "a"
        item "b"
          simple "b"
            word "b"

"case x in a) ;; esac"
  item "case x in a) ;; esac"
    case "case x in a) ;; esac"
      word "x"
      arm "a)"
        pattern "a"

"case x in a|b) c;; d) e;; esac"
  item "case x in a|b) c;; d) e;; esac"
    case "case x in a|b) c;; d) e;; esac"
      word "x"
      arm "a|b) c"
        pattern "a"
        pattern "b"
        item "c"
          simple "c"
            word "c"
      arm "d) e"
        pattern "d"
        item "e"
          simple "e"
            word "e"

"case x in (a|b) c;; (d) e;; esac"
  item "case x in (a|b) c;; (d) e;; esac"
    case "case x in (a|b) c;; (d) e;; esac"
      word "x"
      arm "(a|b) c"
        pattern "a"
        pattern "b"
        item "c"
          simple "c"
            word "c"
      arm "(d) e"
        pattern "d"
        item "e"
          simple "e"
            word "e"

"case $x in\n\n  a)\n\n   b\n\n   ;;\n\n  *)\n   c\n\nesac"
  item "case $x in\n\n  a)\n\n   b\n\n   ;;\n\n  *)\n   c\n\nesac"
    case "case $x in\n\n  a)\n\n   b\n\n   ;;\n\n  *)\n   c\n\nesac"
      word "$x"
        param "$x" name="x" at "x"
      arm "a)\n\n   b"
        pattern "a"
        item "b"
          simple "b"
            word "b"
      arm "*)\n   c"
        pattern "*"
        item "c"
          simple "c"
            word "c"

"case x\nin a) b;; esac"
  item "case x\nin a) b;; esac"
    case "case x\nin a) b;; esac"
      word "x"
      arm "a) b"
        pattern "a"
        item "b"
          simple "b"
            word "b"

"case x in (esac) a;; esac"
  item "case x in (esac) a;; esac"
    case "case x in (esac) a;; esac"
      word "x"
      arm "(esac) a"
        pattern "esac"
        item "a"
          simple "a"
            word "a"

"case x in a|esac) b;; esac"
  item "case x in a|esac) b;; esac"
    case "case x in a|esac) b;; esac"
      word "x"
      arm "a|esac) b"
        pattern "a"
        pattern "esac"
        item "b"
          simple "b"
            word "b"

"case x in a) b;; (esac) c;; esac"
  item "case x in a) b;; (esac) c;; esac"
    case "case x in a) b;; (esac) c;; esac"
      word "x"
      arm "a) b"
        pattern "a"
        item "b"
          simple "b"
            word "b"
      arm "(esac) c"
        pattern "esac"
        item "c"
          simple "c"
            word "c"

"case in in in) a;; esac"
  item "case in in in) a;; esac"
    case "case in in in) a;; esac"
      word "in"
      arm "in) a"
        pattern "in"
        item "a"
          simple "a"
            word "a"

"case x in if) a;; then) b;; esac"
  item "case x in if) a;; then) b;; esac"
    case "case x in if) a;; then) b;; esac"
      word "x"
      arm "if) a"
        pattern "if"
        item "a"
          simple "a"
            word "a"
      arm "then) b"
        pattern "then"
        item "b"
          simple "b"
            word "b"

"case x in a) (b) ;; esac"
  item "case x in a) (b) ;; esac"
    case "case x in a) (b) ;; esac"
      word "x"
      arm "a) (b)"
        pattern "a"
        item "(b)"
          subshell "(b)"
            item "b"
              simple "b"
                word "b"

"case x in a) b; c;; d) e & esac"
  item "case x in a) b; c;; d) e & esac"
    case "case x in a) b; c;; d) e & esac"
      word "x"
      arm "a) b; c"
        pattern "a"
        item "b;"
          simple "b"
            word "b"
        item "c"
          simple "c"
            word "c"
      arm "d) e &"
        pattern "d"
        item "e &" background
          simple "e"
            word "e"

"case x in a) b;; esac >f"
  item "case x in a) b;; esac >f"
    case "case x in a) b;; esac >f"
      word "x"
      arm "a) b"
        pattern "a"
        item "b"
          simple "b"
            word "b"
      redirect ">f" Output
        target "f"

"case x in \"a b\"|$y|*.z) c;; esac"
  item "case x in \"a b\"|$y|*.z) c;; esac"
    case "case x in \"a b\"|$y|*.z) c;; esac"
      word "x"
      arm "\"a b\"|$y|*.z) c"
        pattern "\"a b\""
          double "\"a b\""
            literal "a b"
        pattern "$y"
          param "$y" name="y" at "y"
        pattern "*.z"
        item "c"
          simple "c"
            word "c"

"case x in # note\n a) # note\n b;; # note\nesac # note"
  item "case x in # note\n a) # note\n b;; # note\nesac"
    case "case x in # note\n a) # note\n b;; # note\nesac"
      word "x"
      arm "a) # note\n b"
        pattern "a"
        item "b"
          simple "b"
            word "b"

"case x in a) case y in b) c;; esac;; esac"
  item "case x in a) case y in b) c;; esac;; esac"
    case "case x in a) case y in b) c;; esac;; esac"
      word "x"
      arm "a) case y in b) c;; esac"
        pattern "a"
        item "case y in b) c;; esac"
          case "case y in b) c;; esac"
            word "y"
            arm "b) c"
              pattern "b"
              item "c"
                simple "c"
                  word "c"

"case x in a) if b; then c; fi;; d) { e; };; esac"
  item "case x in a) if b; then c; fi;; d) { e; };; esac"
    case "case x in a) if b; then c; fi;; d) { e; };; esac"
      word "x"
      arm "a) if b; then c; fi"
        pattern "a"
        item "if b; then c; fi"
          if "if b; then c; fi"
            branch "if b; then c;"
              condition
                item "b;"
                  simple "b"
                    word "b"
              then
                item "c;"
                  simple "c"
                    word "c"
      arm "d) { e; }"
        pattern "d"
        item "{ e; }"
          group "{ e; }"
            item "e;"
              simple "e"
                word "e"

"case x in a) b;; esac; case y in c) d;; esac"
  item "case x in a) b;; esac;"
    case "case x in a) b;; esac"
      word "x"
      arm "a) b"
        pattern "a"
        item "b"
          simple "b"
            word "b"
  item "case y in c) d;; esac"
    case "case y in c) d;; esac"
      word "y"
      arm "c) d"
        pattern "c"
        item "d"
          simple "d"
            word "d"
