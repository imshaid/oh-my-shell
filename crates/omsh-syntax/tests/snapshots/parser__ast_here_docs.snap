---
source: crates/omsh-syntax/tests/parser.rs
expression: render_lines(lines)
---
"cat <<EOF\nhello $x $(y) `z` \\$ \\q \"q\" 'q'\nEOF\n"
  item "cat <<EOF"
    simple "cat <<EOF"
      word "cat"
      here-doc "<<EOF" delimiter="EOF"
        body "hello $x $(y) `z` \\$ \\q \"q\" 'q'\n"
          literal "hello "
          param "$x" name="x" at "x"
          literal " "
          command-sub "$(y)"
            item "y"
              simple "y"
                word "y"
          literal " "
          command-sub "`z`"
            item "z"
              simple "z"
                word "z"
          literal " "
          escaped "$" at "\\$"
          literal " \\q \"q\" 'q'\n"

"cat <<'EOF'\nraw $x \\$\nEOF\n"
  item "cat <<'EOF'"
    simple "cat <<'EOF'"
      word "cat"
      here-doc "<<'EOF'" delimiter="EOF" quoted
        body "raw $x \\$\n"
          literal "raw $x \\$\n"

"cat <<\"EOF\"\nraw $x\nEOF\n"
  item "cat <<\"EOF\""
    simple "cat <<\"EOF\""
      word "cat"
      here-doc "<<\"EOF\"" delimiter="EOF" quoted
        body "raw $x\n"
          literal "raw $x\n"

"cat <<\\EOF\nraw $x\nEOF\n"
  item "cat <<\\EOF"
    simple "cat <<\\EOF"
      word "cat"
      here-doc "<<\\EOF" delimiter="EOF" quoted
        body "raw $x\n"
          literal "raw $x\n"

"cat <<E\"O\"F\nraw $x\nEOF\n"
  item "cat <<E\"O\"F"
    simple "cat <<E\"O\"F"
      word "cat"
      here-doc "<<E\"O\"F" delimiter="EOF" quoted
        body "raw $x\n"
          literal "raw $x\n"

"cat <<-EOF\n\tone\n\t\ttwo $x\n\tEOF\n"
  item "cat <<-EOF"
    simple "cat <<-EOF"
      word "cat"
      here-doc "<<-EOF" delimiter="EOF" strip-tabs
        body "\tone\n\t\ttwo $x\n"
          literal "one\ntwo " at "one\n\t\ttwo "
          param "$x" name="x" at "x"
          literal "\n"

"cat <<A <<B | grep x # note\nfirst\nA\nsecond\nB\nnext\n"
  item "cat <<A <<B | grep x"
    pipeline "cat <<A <<B | grep x"
      simple "cat <<A <<B"
        word "cat"
        here-doc "<<A" delimiter="A"
          body "first\n"
            literal "first\n"
        here-doc "<<B" delimiter="B"
          body "second\n"
            literal "second\n"
      simple "grep x"
        word "grep"
        word "x"
  item "next"
    simple "next"
      word "next"

"cat 3<<A; cat <<B\nfirst\nA\nsecond\nB\n"
  item "cat 3<<A;"
    simple "cat 3<<A"
      word "cat"
      here-doc "3<<A" fd=3 delimiter="A"
        body "first\n"
          literal "first\n"
  item "cat <<B"
    simple "cat <<B"
      word "cat"
      here-doc "<<B" delimiter="B"
        body "second\n"
          literal "second\n"

"cat <<EOF\nno newline after delimiter\nEOF"
  item "cat <<EOF"
    simple "cat <<EOF"
      word "cat"
      here-doc "<<EOF" delimiter="EOF"
        body "no newline after delimiter\n"
          literal "no newline after delimiter\n"

"cat <<EOF\nEOF\n"
  item "cat <<EOF"
    simple "cat <<EOF"
      word "cat"
      here-doc "<<EOF" delimiter="EOF"
        body ""

"cat << -EOF\n-EOF\n"
  item "cat << -EOF"
    simple "cat << -EOF"
      word "cat"
      here-doc "<< -EOF" delimiter="-EOF"
        body ""

"if a; then cat <<EOF\nbody\nEOF\nfi"
  item "if a; then cat <<EOF\nbody\nEOF\nfi"
    if "if a; then cat <<EOF\nbody\nEOF\nfi"
      branch "if a; then cat <<EOF"
        condition
          item "a;"
            simple "a"
              word "a"
        then
          item "cat <<EOF"
            simple "cat <<EOF"
              word "cat"
              here-doc "<<EOF" delimiter="EOF"
                body "body\n"
                  literal "body\n"

"{ cat <<A; } | cat <<B\nfirst\nA\nsecond\nB\n"
  item "{ cat <<A; } | cat <<B"
    pipeline "{ cat <<A; } | cat <<B"
      group "{ cat <<A; }"
        item "cat <<A;"
          simple "cat <<A"
            word "cat"
            here-doc "<<A" delimiter="A"
              body "first\n"
                literal "first\n"
      simple "cat <<B"
        word "cat"
        here-doc "<<B" delimiter="B"
          body "second\n"
            literal "second\n"

"x=$(cat <<EOF\ninner )\nEOF\n)\n"
  item "x=$(cat <<EOF\ninner )\nEOF\n)"
    simple "x=$(cat <<EOF\ninner )\nEOF\n)"
      assign "x=$(cat <<EOF\ninner )\nEOF\n)" name="x" at "x"
        value "$(cat <<EOF\ninner )\nEOF\n)"
          command-sub "$(cat <<EOF\ninner )\nEOF\n)"
            item "cat <<EOF"
              simple "cat <<EOF"
                word "cat"
                here-doc "<<EOF" delimiter="EOF"
                  body "inner )\n"
                    literal "inner )\n"

"cat <<EOF\n$(cat <<A\ninner\nA\n)\nEOF\n"
  item "cat <<EOF"
    simple "cat <<EOF"
      word "cat"
      here-doc "<<EOF" delimiter="EOF"
        body "$(cat <<A\ninner\nA\n)\n"
          command-sub "$(cat <<A\ninner\nA\n)"
            item "cat <<A"
              simple "cat <<A"
                word "cat"
                here-doc "<<A" delimiter="A"
                  body "inner\n"
                    literal "inner\n"
          literal "\n"

"cat <<EOF\n`a \\\"b\\\"`\nEOF\n"
  item "cat <<EOF"
    simple "cat <<EOF"
      word "cat"
      here-doc "<<EOF" delimiter="EOF"
        body "`a \\\"b\\\"`\n"
          command-sub "`a \\\"b\\\"`"
            item "a \\\"b\\\""
              simple "a \\\"b\\\""
                word "a"
                word "\"b\\\""
                  double "\"b\\\""
                    literal "b"
          literal "\n"

"cat <<E\\\nF\nbody\nEF\n"
  item "cat <<E\\\nF"
    simple "cat <<E\\\nF"
      word "cat"
      here-doc "<<E\\\nF" delimiter="EF"
        body "body\n"
          literal "body\n"

"cat <<A; echo $(cat <<B\ninner\nB\n)\nouter\nA\n"
  item "cat <<A;"
    simple "cat <<A"
      word "cat"
      here-doc "<<A" delimiter="A"
        body "outer\n"
          literal "outer\n"
  item "echo $(cat <<B\ninner\nB\n)"
    simple "echo $(cat <<B\ninner\nB\n)"
      word "echo"
      word "$(cat <<B\ninner\nB\n)"
        command-sub "$(cat <<B\ninner\nB\n)"
          item "cat <<B"
            simple "cat <<B"
              word "cat"
              here-doc "<<B" delimiter="B"
                body "inner\n"
                  literal "inner\n"

"cat <<A # note\nbody\nA\n"
  item "cat <<A"
    simple "cat <<A"
      word "cat"
      here-doc "<<A" delimiter="A"
        body "body\n"
          literal "body\n"

"while a; do cat <<A; done\nbody\nA\n"
  item "while a; do cat <<A; done"
    while "while a; do cat <<A; done"
      condition
        item "a;"
          simple "a"
            word "a"
      do
        item "cat <<A;"
          simple "cat <<A"
            word "cat"
            here-doc "<<A" delimiter="A"
              body "body\n"
                literal "body\n"

"f() { cat <<A; }\nbody\nA\n"
  item "f() { cat <<A; }"
    function "f() { cat <<A; }" name="f" at "f"
      group "{ cat <<A; }"
        item "cat <<A;"
          simple "cat <<A"
            word "cat"
            here-doc "<<A" delimiter="A"
              body "body\n"
                literal "body\n"
