---
source: crates/omsh-syntax/tests/lexer.rs
expression: render_tokens(lines)
---
"# whole line"
  0..12 Comment "# whole line"

"a # trailing $x 'unclosed"
  0..1 Word "a"
  2..25 Comment "# trailing $x 'unclosed"

"a#b #c"
  0..3 Word "a#b"
  4..6 Comment "#c"

"#a\n#b\nc"
  0..2 Comment "#a"
  2..3 Newline
  3..5 Comment "#b"
  5..6 Newline
  6..7 Word "c"

"a \\\n#b"
  0..1 Word "a"
  4..6 Comment "#b"

"a\\\n#b"
  0..5 Word "a\\\n#b"
    0..1 Literal "a"
    1..3 LineContinuation
    3..5 Literal "#b"

"a #b\\\nc"
  0..1 Word "a"
  2..5 Comment "#b\\"
  5..6 Newline
  6..7 Word "c"
