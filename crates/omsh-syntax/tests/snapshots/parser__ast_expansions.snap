---
source: crates/omsh-syntax/tests/parser.rs
expression: render_lines(lines)
---
"$x ${x} ${#x} $_a1 $é"
  item "$x ${x} ${#x} $_a1 $é"
    simple "$x ${x} ${#x} $_a1 $é"
      word "$x"
        param "$x" name="x" at "x"
      word "${x}"
        param "${x}" name="x" at "x"
      word "${#x}"
        param "${#x}" name="x" at "x" length
      word "$_a1"
        param "$_a1" name="_a1" at "_a1"
      word "$é"

"$? $$ $! $0 $# $@ $* $- $1 $9 $10 ${10}"
  item "$? $$ $! $0 $# $@ $* $- $1 $9 $10 ${10}"
    simple "$? $$ $! $0 $# $@ $* $- $1 $9 $10 ${10}"
      word "$?"
        param "$?" name="?" at "?"
      word "$$"
        param "$$" name="$" at "$"
      word "$!"
        param "$!" name="!" at "!"
      word "$0"
        param "$0" name="0" at "0"
      word "$#"
        param "$#" name="#" at "#"
      word "$@"
        param "$@" name="@" at "@"
      word "$*"
        param "$*" name="*" at "*"
      word "$-"
        param "$-" name="-" at "-"
      word "$1"
        param "$1" name="1" at "1"
      word "$9"
        param "$9" name="9" at "9"
      word "$10"
        param "$1" name="1" at "1"
        literal "0"
      word "${10}"
        param "${10}" name="10" at "10"

"${x:-a b} ${x:=$y} ${x:?msg} ${x:+w}"
  item "${x:-a b} ${x:=$y} ${x:?msg} ${x:+w}"
    simple "${x:-a b} ${x:=$y} ${x:?msg} ${x:+w}"
      word "${x:-a b}"
        param "${x:-a b}" name="x" at "x" ColonDash at ":-"
          literal "a b"
      word "${x:=$y}"
        param "${x:=$y}" name="x" at "x" ColonEquals at ":="
          param "$y" name="y" at "y"
      word "${x:?msg}"
        param "${x:?msg}" name="x" at "x" ColonQuestion at ":?"
          literal "msg"
      word "${x:+w}"
        param "${x:+w}" name="x" at "x" ColonPlus at ":+"
          literal "w"

"${x-a} ${x=a} ${x?a} ${x+a}"
  item "${x-a} ${x=a} ${x?a} ${x+a}"
    simple "${x-a} ${x=a} ${x?a} ${x+a}"
      word "${x-a}"
        param "${x-a}" name="x" at "x" Dash at "-"
          literal "a"
      word "${x=a}"
        param "${x=a}" name="x" at "x" Equals at "="
          literal "a"
      word "${x?a}"
        param "${x?a}" name="x" at "x" Question at "?"
          literal "a"
      word "${x+a}"
        param "${x+a}" name="x" at "x" Plus at "+"
          literal "a"

"${x#p} ${x##p} ${x%p} ${x%%p}"
  item "${x#p} ${x##p} ${x%p} ${x%%p}"
    simple "${x#p} ${x##p} ${x%p} ${x%%p}"
      word "${x#p}"
        param "${x#p}" name="x" at "x" Hash at "#"
          literal "p"
      word "${x##p}"
        param "${x##p}" name="x" at "x" DoubleHash at "##"
          literal "p"
      word "${x%p}"
        param "${x%p}" name="x" at "x" Percent at "%"
          literal "p"
      word "${x%%p}"
        param "${x%%p}" name="x" at "x" DoublePercent at "%%"
          literal "p"

"\"${x:-\"a b\"}\" ${x:-${y:-$(z)}}"
  item "\"${x:-\"a b\"}\" ${x:-${y:-$(z)}}"
    simple "\"${x:-\"a b\"}\" ${x:-${y:-$(z)}}"
      word "\"${x:-\"a b\"}\""
        double "\"${x:-\"a b\"}\""
          param "${x:-\"a b\"}" name="x" at "x" ColonDash at ":-"
            double "\"a b\""
              literal "a b"
      word "${x:-${y:-$(z)}}"
        param "${x:-${y:-$(z)}}" name="x" at "x" ColonDash at ":-"
          param "${y:-$(z)}" name="y" at "y" ColonDash at ":-"
            command-sub "$(z)"
              item "z"
                simple "z"
                  word "z"

"$\\\nx ${\\\ny} $z\\\nw"
  item "$\\\nx ${\\\ny} $z\\\nw"
    simple "$\\\nx ${\\\ny} $z\\\nw"
      word "$\\\nx"
        param "$\\\nx" name="x" at "x"
      word "${\\\ny}"
        param "${\\\ny}" name="y" at "y"
      word "$z\\\nw"
        param "$z\\\nw" name="zw" at "z\\\nw"

"$((1 + 2)) $(( $x * (2 + $(y)) )) $(())"
  item "$((1 + 2)) $(( $x * (2 + $(y)) )) $(())"
    simple "$((1 + 2)) $(( $x * (2 + $(y)) )) $(())"
      word "$((1 + 2))"
        arithmetic "$((1 + 2))"
          literal "1 + 2"
      word "$(( $x * (2 + $(y)) ))"
        arithmetic "$(( $x * (2 + $(y)) ))"
          literal " "
          param "$x" name="x" at "x"
          literal " * (2 + "
          command-sub "$(y)"
            item "y"
              simple "y"
                word "y"
          literal ") "
      word "$(())"
        arithmetic "$(())"

"\"$((1 + \"$x\"))\""
  item "\"$((1 + \"$x\"))\""
    simple "\"$((1 + \"$x\"))\""
      word "\"$((1 + \"$x\"))\""
        double "\"$((1 + \"$x\"))\""
          arithmetic "$((1 + \"$x\"))"
            literal "1 + "
            double "\"$x\""
              param "$x" name="x" at "x"

"${x//a/b} ${x:1:2} ${#x:-y} ${}"
  item "${x//a/b} ${x:1:2} ${#x:-y} ${}"
    simple "${x//a/b} ${x:1:2} ${#x:-y} ${}"
      word "${x//a/b}"
        param "${x//a/b}" name="x" at "x" Unsupported at ""
          literal "//a/b"
      word "${x:1:2}"
        param "${x:1:2}" name="x" at "x" Unsupported at ""
          literal ":1:2"
      word "${#x:-y}"
        param "${#x:-y}" name="x" at "x" length Unsupported at ":-"
          literal "y"
      word "${}"
        param "${}" name="" at ""
