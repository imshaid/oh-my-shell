---
source: crates/omsh-syntax/tests/parser.rs
expression: render_lines(lines)
---
"FOO=bar"
  item "FOO=bar"
    simple "FOO=bar"
      assign "FOO=bar" name="FOO" at "FOO"
        value "bar"

"FOO=bar cmd"
  item "FOO=bar cmd"
    simple "FOO=bar cmd"
      assign "FOO=bar" name="FOO" at "FOO"
        value "bar"
      word "cmd"

"A=1 B=\"x y\" cmd A=not-prefix"
  item "A=1 B=\"x y\" cmd A=not-prefix"
    simple "A=1 B=\"x y\" cmd A=not-prefix"
      assign "A=1" name="A" at "A"
        value "1"
      assign "B=\"x y\"" name="B" at "B"
        value "\"x y\""
          double "\"x y\""
            literal "x y"
      word "cmd"
      word "A=not-prefix"

"FOO= cmd"
  item "FOO= cmd"
    simple "FOO= cmd"
      assign "FOO=" name="FOO" at "FOO"
        value ""
      word "cmd"

"A=1 >f B=2 c D=3"
  item "A=1 >f B=2 c D=3"
    simple "A=1 >f B=2 c D=3"
      assign "A=1" name="A" at "A"
        value "1"
      assign "B=2" name="B" at "B"
        value "2"
      word "c"
      word "D=3"
      redirect ">f" Output
        target "f"

">f A=1"
  item ">f A=1"
    simple ">f A=1"
      assign "A=1" name="A" at "A"
        value "1"
      redirect ">f" Output
        target "f"

"A=$x$(y)z"
  item "A=$x$(y)z"
    simple "A=$x$(y)z"
      assign "A=$x$(y)z" name="A" at "A"
        value "$x$(y)z"
          param "$x" name="x" at "x"
          command-sub "$(y)"
            item "y"
              simple "y"
                word "y"
          literal "z"

"F\\\nOO=b"
  item "F\\\nOO=b"
    simple "F\\\nOO=b"
      assign "F\\\nOO=b" name="FOO" at "F\\\nOO"
        value "b"

"FOO\\\n=b"
  item "FOO\\\n=b"
    simple "FOO\\\n=b"
      assign "FOO\\\n=b" name="FOO" at "FOO"
        value "b"

"FOO=\\\nb"
  item "FOO=\\\nb"
    simple "FOO=\\\nb"
      assign "FOO=\\\nb" name="FOO" at "FOO"
        value "\\\nb"
          literal "b"

"A=b=c"
  item "A=b=c"
    simple "A=b=c"
      assign "A=b=c" name="A" at "A"
        value "b=c"

"A=~/x:~/y"
  item "A=~/x:~/y"
    simple "A=~/x:~/y"
      assign "A=~/x:~/y" name="A" at "A"
        value "~/x:~/y"

"A=1 if"
  item "A=1 if"
    simple "A=1 if"
      assign "A=1" name="A" at "A"
        value "1"
      word "if"

"1A=b"
  item "1A=b"
    simple "1A=b"
      word "1A=b"

"F\"OO\"=b"
  item "F\"OO\"=b"
    simple "F\"OO\"=b"
      word "F\"OO\"=b"
        literal "F"
        double "\"OO\""
          literal "OO"
        literal "=b"

"FOO\\=b"
  item "FOO\\=b"
    simple "FOO\\=b"
      word "FOO\\=b"
        literal "FOO"
        escaped "=" at "\\="
        literal "b"
